# Default: deterministic, local, and offline.
AI_PROVIDER=mock
MOCK_AI_MODE=true
ENABLE_EXTERNAL_AI=false
EXTERNAL_AI_ENDPOINT=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=

# Browser origins allowed to call the upload endpoint.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload validation limits (1-25 MiB and 1-50,000,000 pixels).
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=25000000

# Used only when external inference is explicitly enabled.
EXTERNAL_AI_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_AI_READ_TIMEOUT_SECONDS=30
EXTERNAL_AI_REQUEST_TIMEOUT_SECONDS=45
EXTERNAL_AI_MAX_RETRIES=1
EXTERNAL_AI_RETRY_BACKOFF_SECONDS=0.25
EXTERNAL_AI_RETRY_MAX_BACKOFF_SECONDS=5
EXTERNAL_AI_RETRY_JITTER_SECONDS=0.1
EXTERNAL_AI_CIRCUIT_FAILURE_THRESHOLD=3
EXTERNAL_AI_CIRCUIT_COOLDOWN_SECONDS=30

# EXTERNAL_AI_TIMEOUT_SECONDS remains accepted as a legacy read-timeout alias.

# Optional external mode requires all values below.
# AI_PROVIDER=external
# MOCK_AI_MODE=false
# ENABLE_EXTERNAL_AI=true
# EXTERNAL_AI_ENDPOINT=https://your-inference-endpoint.example/v1/messages
# EXTERNAL_AI_API_KEY=your_provider_key_here
# EXTERNAL_AI_MODEL=your-model
