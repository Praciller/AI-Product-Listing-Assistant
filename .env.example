# Default: deterministic, local, and offline.
AI_PROVIDER=mock
MOCK_AI_MODE=true
ENABLE_EXTERNAL_AI=false
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Optional Gemini mode requires all four values below.
# AI_PROVIDER=gemini
# MOCK_AI_MODE=false
# ENABLE_EXTERNAL_AI=true
# GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional OpenRouter free multimodal mode requires all values below.
# AI_PROVIDER=openrouter
# MOCK_AI_MODE=false
# ENABLE_EXTERNAL_AI=true
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
