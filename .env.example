# Default: deterministic, local, and offline.
AI_PROVIDER=mock
MOCK_AI_MODE=true
ENABLE_EXTERNAL_AI=false

# Optional generic external inference endpoint.
EXTERNAL_AI_ENDPOINT=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=
EXTERNAL_AI_TIMEOUT_SECONDS=20

# To opt in to external inference:
# AI_PROVIDER=external
# MOCK_AI_MODE=false
# ENABLE_EXTERNAL_AI=true
# EXTERNAL_AI_ENDPOINT=https://your-inference-endpoint.example/v1/messages
# EXTERNAL_AI_API_KEY=your_server_side_key_here
# EXTERNAL_AI_MODEL=your_vision_model
